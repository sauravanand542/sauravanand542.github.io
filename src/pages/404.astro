---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found · Saurav Anand"
  description="That path is not on Saurav Anand’s portfolio."
  path="/404.html"
  sectionNav={false}
>
  <main id="main">
    <div class="wrap">
      <article class="missing">
        <p class="kicker">404</p>
        <h1>Page not found</h1>
        <p>That path is not on this site. The portfolio lives on the home page.</p>
        <div class="actions">
          <a class="button button-primary" href="/">Back home</a>
        </div>
      </article>
    </div>
  </main>
</Base>
