---
import ProjectDetails from "./ProjectDetails.astro";
import { factsAsOf, formatFactsDate, profile, type Project } from "../data/profile";

const projects = profile.projects;
const featured = projects.find((project) => project.featured);
const rest = projects.filter((project) => !project.featured);
const asOf = formatFactsDate(factsAsOf);

function countLabel(project: Project): string | undefined {
  const parts: string[] = [];
  if (typeof project.stars === "number") {
    parts.push(`${project.stars} ${project.stars === 1 ? "star" : "stars"}`);
  }
  if (typeof project.forks === "number" && project.forks > 0) {
    parts.push(`${project.forks} ${project.forks === 1 ? "fork" : "forks"}`);
  }
  if (parts.length === 0) return undefined;
  return `${parts.join(" · ")} on the GitHub API, ${asOf}`;
}
---

<section class="section" id="projects" aria-labelledby="projects-heading">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">Projects</p>
      <h2 id="projects-heading">Selected repositories</h2>
      <p class="section-intro">
        Six public repositories, written as short briefs: what the work is for, how it was built, and what it produced.
        Star and fork counts were read from the GitHub API on {asOf}. A card with no count had none that day.
      </p>
    </header>

    {
      featured && (
        <article class="project-feature" data-reveal>
          <p class="project-kicker">Featured</p>
          <h3>{featured.title}</h3>
          <p class="project-meta">
            <span class="language">{featured.language}</span>
            {featured.license && <span>{featured.license}</span>}
            {countLabel(featured) && <span>{countLabel(featured)}</span>}
          </p>
          <ProjectDetails project={featured} />
        </article>
      )
    }

    <div class="grid gap-5 md:grid-cols-2">
      {
        rest.map((project, index) => (
          <article class="project-card" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <h3>{project.title}</h3>
            <p class="project-meta">
              <span class="language">{project.language}</span>
              {countLabel(project) && <span>{countLabel(project)}</span>}
            </p>
            <ProjectDetails project={project} />
          </article>
        ))
      }
    </div>
  </div>
</section>
