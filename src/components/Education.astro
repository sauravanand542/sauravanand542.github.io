---
import { profile } from "../data/profile";

const items = profile.education;
---

{
  items.length > 0 && (
    <section class="section" id="education" aria-labelledby="education-heading">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <p class="kicker">Education</p>
          <h2 id="education-heading">Education</h2>
        </header>
        <ul class="record-list">
          {items.map((item) => (
            <li class="record-card" data-reveal>
              {(item.start || item.end) && (
                <p class="when">
                  {item.start ? item.start : ""}
                  {item.start && item.end ? " — " : ""}
                  {item.end ? item.end : ""}
                </p>
              )}
              <h3>{item.credential}</h3>
              <p class="org">{item.school}</p>
              {item.detail && <p class="project-summary">{item.detail}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
